    "/rooms/{roomId}/nodes": {
      "get": {
        "operationId": "NodesController_list",
        "parameters": [
          {
            "name": "parentId",
            "required": false,
            "in": "query",
            "description": "Folder to list; defaults to the room root",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Keyset cursor from a previous page",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "maximum": 200,
              "default": 50,
              "type": "number"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "default": "name",
              "type": "string",
              "enum": [
                "name",
                "updatedAt",
                "size"
              ]
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not found or no access"
          },
          "410": {
            "description": "The folder or an ancestor was deleted by the owner"
          },
          "422": {
            "description": "Malformed cursor"
          }
        },
        "security": [
          {
            "share-token": []
          },
          {
            "access-token": []
          }
        ],
        "summary": "List a folder: children, breadcrumbs and the caller role",
        "tags": [
          "nodes"
        ]
      }
    },
