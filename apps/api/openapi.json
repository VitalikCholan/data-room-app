          "410": {
            "description": "Deleted by the owner, or the stored object no longer matches what was verified at upload"
          }
        },
        "security": [
          {
            "share-token": []
          },
          {
            "access-token": []
          }
        ],
        "summary": "Redirect to a 5-minute presigned GET for viewing in the browser",
        "tags": [
          "files"
        ]
      }
    },
    "/nodes/{id}/shares": {
      "post": {
        "operationId": "SharesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShareDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "For PUBLIC_LINK the raw token is returned once and never again"
          },
          "403": {
            "description": "Read-only access"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Share a Data Room, folder or file (read-only)",
        "tags": [
          "shares"
        ]
      },
      "get": {
        "operationId": "SharesController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Shares on this item, including revoked ones",
        "tags": [
          "shares"
        ]
      }
    },
    "/shares/{id}": {
      "delete": {
        "operationId": "SharesController_revoke",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not found or not owned by the caller"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Revoke a share",
        "tags": [
          "shares"
        ]
      }
    },
    "/shared/{token}": {
      "get": {
        "operationId": "PublicShareController_resolve",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "No such link"
          },
          "410": {
            "description": "Link revoked, or the item was deleted"
          }
        },
        "summary": "Resolve a public link into its target — no authentication required",
        "tags": [
          "shares"
        ]
      }
    }
  },
  "info": {
    "title": "Data Room API",
    "description": "Owner-scoped document repository with read-only sharing",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "share-token": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Share-Token"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "analyst@acme.io"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "password123"
          },
          "name": {
            "type": "string",
            "example": "Dana Analyst"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo@dataroom.app"
          },
          "password": {
            "type": "string",
            "example": "demo1234"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateRoomDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Project Titan — Acme Acquisition"
          }
        },
        "required": [
          "name"
        ]
      },
      "RenameRoomDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Project Titan — Acme Acquisition"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateFolderDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Financials"
          },
          "parentId": {
            "type": "string",
            "description": "Parent folder id; the room root id for a top-level folder"
          }
        },
        "required": [
          "name",
          "parentId"
        ]
      },
      "RenameNodeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Financials"
          }
        },
        "required": [
          "name"
        ]
      },
      "MoveNodeDto": {
        "type": "object",
        "properties": {
          "targetParentId": {
            "type": "string",
            "description": "Destination folder id"
          }
        },
        "required": [
          "targetParentId"
        ]
      },
      "PresignUploadDto": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "FY23 Audit.pdf"
          },
          "sizeBytes": {
            "type": "number",
            "description": "Client-reported size; re-read from the bucket on confirm"
          },
          "mimeType": {
            "type": "string",
            "example": "application/pdf"
          },
          "onConflict": {
            "type": "string",
            "enum": [
              "KEEP_BOTH"
            ],
            "description": "Omit to receive 409 NAME_CONFLICT and let the user choose"
          }
        },
        "required": [
          "parentId",
          "name",
          "sizeBytes",
          "mimeType"
        ]
      },
      "ConfirmUploadDto": {
        "type": "object",
        "properties": {
          "versionId": {
            "type": "string",
            "description": "Version id returned by presign"
          }
        },
        "required": [
          "versionId"
        ]
      },
      "CreateShareDto": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "PUBLIC_LINK",
              "USER"
            ]
          },
          "email": {
            "type": "string",
            "description": "Required for mode USER; may be an address with no account yet"
          }
        },
        "required": [
          "mode"
        ]
      }
    }
  }
}
