    "/rooms/{roomId}/uploads/presign": {
      "post": {
        "operationId": "UploadsController_presign",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresignUploadDto"
              }
            }
          }
        },
        "responses": {
          "409": {
            "description": "NAME_CONFLICT — resend with onConflict to resolve"
          },
          "413": {
            "description": "Declared size exceeds 50 MB"
          },
          "415": {
            "description": "Only application/pdf is accepted"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Reserve a file row and return a presigned PUT url",
        "tags": [
          "uploads"
        ]
      }
    },
    "/uploads/{nodeId}/confirm": {
      "post": {
        "operationId": "UploadsController_confirm",
        "parameters": [
          {
            "name": "nodeId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmUploadDto"
              }
            }
          }
        },
        "responses": {
          "409": {
            "description": "UPLOAD_NOT_FOUND — the object is not in storage yet"
          },
          "413": {
            "description": "Stored object exceeds 50 MB; it has been deleted"
          },
          "415": {
            "description": "Stored object is not a PDF; it has been deleted"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Verify the uploaded object and activate the file",
        "tags": [
          "uploads"
        ]
      }
    },
    "/nodes/{id}/content": {
      "get": {
        "operationId": "FilesController_content",
        "parameters": [],
        "responses": {
          "302": {
