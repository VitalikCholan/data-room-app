# Template for apps/api/.env.test, which `pnpm --filter api test:e2e` reads via
# DOTENV_CONFIG_PATH. Copy it as-is — the values below match docker-compose.yml:
#
#   cp apps/api/.env.test.example apps/api/.env.test
#   docker compose exec -T postgres createdb -U dataroom dataroom_test
#   DATABASE_URL="postgresql://dataroom:dataroom@localhost:5433/dataroom_test?schema=public" \
#     pnpm --filter api exec prisma migrate deploy
#
# .env.test itself stays gitignored, like every other real env file.
#
# The database MUST be a separate one whose name ends in `_test`: every spec truncates
# every table in `afterAll`, so a run pointed at the development database wipes it. The
# suite refuses to start otherwise (test/support/require-test-database.ts).
DATABASE_URL="postgresql://dataroom:dataroom@localhost:5433/dataroom_test?schema=public"
JWT_SECRET="test-jwt-secret-change-me-too"
REFRESH_SECRET="test-refresh-secret-change-me"
PUBLIC_APP_URL="http://localhost:5173"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="data-room"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
